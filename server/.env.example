PORT=3000
DATABASE_URL=postgres://saturno:saturno@localhost:5432/saturno
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
APP_TZ=Europe/Madrid

# Administrador inicial (solo se crea si la tabla de usuarios está vacía)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=admin1234

# Vacaciones
VACATION_DAYS_PER_YEAR=30
# cycle = el proporcional del ciclo se asigna entero al empezar el ciclo
# progressive = se devenga día a día hasta hoy
ACCRUAL_MODE=cycle
# Horas de una jornada completa: las solicitudes por horas descuentan horas / WORKDAY_HOURS días
WORKDAY_HOURS=8

# Festivos propuestos al importar: comunidad (ISO 3166-2) y localidad (solo "valencia" calcula los locales)
HOLIDAYS_REGION=ES-VC
HOLIDAYS_LOCALITY=valencia
